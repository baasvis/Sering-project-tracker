generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ─────────────────────────────────────────────────────────────────
// Enum validation is handled by Zod schemas in lib/schemas.js.
// Columns use String to match the current production database.

model Group {
  id                String    @id @default(uuid())
  name              String
  description       String?
  order             Int       @default(0)
  mattermostChannel String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projects          Project[]

  @@index([deletedAt])
}

model Project {
  id            String    @id @default(uuid())
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id])
  name          String
  description   String?
  contactPerson String?
  tier          String?
  joinType      String?
  status        String    @default("active")
  approved      Boolean   @default(true)
  suggestedBy   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tasks         Task[]
  shoppingItems ShoppingItem[]

  @@index([groupId, status])
}

model Task {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String    @default("todo")
  assignee    String?
  deadline    DateTime?
  order       Int       @default(0)
  approved    Boolean   @default(true)
  suggestedBy String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([projectId, deadline])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  authorEmail String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pinned, createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  targetType String
  targetId   String
  authorName String
  body       String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([authorName, createdAt])
}

model ShoppingItem {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         String   @default("product")
  name         String
  link         String?
  pricePerItem Float?
  quantity     Int?     @default(1)
  amount       Float?
  purchased    Boolean  @default(false)
  suggestedBy  String?
  approved     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, approved])
}

model Media {
  id           String   @id @default(uuid())
  parentType   String
  parentId     String
  type         String
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([parentType, parentId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actor      String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actor, createdAt])
}

model Report {
  id             String   @id @default(uuid())
  description    String
  screenshotData String?
  reporterName   String
  currentPage    String?
  resolved       Boolean  @default(false)
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([resolved, createdAt])
}
