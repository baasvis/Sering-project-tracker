generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum ProjectStatus {
  active
  completed
  archived
}

enum ProjectTier {
  mvp
  medium
  next_level
}

enum JoinType {
  open
  contact
  closed
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum CommentTargetType {
  group
  project
  task
  announcement
}

enum ShoppingItemType {
  product
  cost
}

enum MediaParentType {
  task
  project
  announcement
  comment
}

enum MediaType {
  photo
  voice
}

enum GetTogetherDay {
  day1 // April 11
  day2 // April 12
}

// ─── Models ─────────────────────────────────────────────────────────────────

model Group {
  id                String    @id @default(uuid())
  name              String
  description       String?
  order             Int       @default(0)
  mattermostChannel String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projects          Project[]

  @@index([deletedAt])
}

model Project {
  id            String    @id @default(uuid())
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  name          String
  description   String?
  contactPerson String?
  tier          ProjectTier?
  joinType      JoinType?
  status        ProjectStatus @default(active)
  approved      Boolean   @default(true)
  suggestedBy   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tasks         Task[]
  shoppingItems ShoppingItem[]
  toolItems     ToolItem[]

  @@index([groupId, status])
}

model Task {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      TaskStatus @default(todo)
  assignee    String?
  deadline    DateTime?
  order       Int       @default(0)
  approved    Boolean   @default(true)
  suggestedBy String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([projectId, deadline])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  authorEmail String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pinned, createdAt])
}

model Comment {
  id         String            @id @default(uuid())
  targetType CommentTargetType
  targetId   String
  authorName String
  body       String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([authorName, createdAt])
}

model ShoppingItem {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         ShoppingItemType @default(product)
  name         String
  link         String?
  pricePerItem Decimal?  @db.Decimal(10, 2)
  quantity     Int?     @default(1)
  amount       Decimal?  @db.Decimal(10, 2)
  purchased    Boolean  @default(false)
  suggestedBy  String?
  approved     Boolean  @default(false)
  order        Int      @default(0)
  notes        String?
  category     String?
  importance   String?
  assignedTo   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, approved])
}

model ToolItem {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int      @default(1)
  available   Boolean  @default(false)
  suggestedBy String?
  approved    Boolean  @default(false)
  order       Int      @default(0)
  link        String?
  notes       String?
  category    String?
  importance  String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, approved])
}

// ─── Get Together (one-off event: April 11–12, 2026) ───────────────────────

model GetTogetherLocation {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks GetTogetherBlock[]

  @@index([order])
}

model GetTogetherBlock {
  id          String              @id @default(uuid())
  locationId  String
  location    GetTogetherLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  day         GetTogetherDay
  startTime   String              // HH:MM format, 15-min increments
  endTime     String              // HH:MM format, 15-min increments
  projectId   String?             // Logical reference to Project (not a @relation)
  title       String?             // Required if projectId is null
  description String?
  signupCap   Int?                // null = unlimited
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  signups GetTogetherSignup[]

  @@index([day, locationId])
  @@index([projectId])
}

model GetTogetherSignup {
  id        String           @id @default(uuid())
  blockId   String
  block     GetTogetherBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  name      String           // Visitor name from localStorage
  createdAt DateTime         @default(now())

  @@unique([blockId, name])
  @@index([blockId])
}

model Media {
  id           String          @id @default(uuid())
  parentType   MediaParentType
  parentId     String
  type         MediaType
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([parentType, parentId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actor      String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actor, createdAt])
}

model Report {
  id             String   @id @default(uuid())
  description    String
  screenshotData String?
  reporterName   String
  currentPage    String?
  resolved       Boolean  @default(false)
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([resolved, createdAt])
}
