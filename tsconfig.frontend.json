{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "ignoreDeprecations": "6.0",
    "outDir": "public/js",
    "rootDir": "src/frontend",
    "strict": true,
    "sourceMap": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["src/frontend/**/*.ts"]
}
