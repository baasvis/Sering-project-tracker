# Required in all environments
DATABASE_URL=postgresql://user:password@localhost:5432/sering

# Required in production (app crashes on startup without these)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
SESSION_SECRET=generate-a-random-hex-string-here
ADMIN_EMAILS=admin@example.com,other@example.com

# Optional
NODE_ENV=development
PORT=3001
